// Returns true if the uploaded file is an image and its size is below the given number of MB.
function isImageBelowMaxSize(maxSizeMB) {
  return request.resource.size < maxSizeMB * 1024 * 1024
      && request.resource.contentType.matches('image/.*');
}

service firebase.storage {
  match /b/{bucket}/o {

    // Look up classroom ownership / membership for the storage rules below.
    function isClassroomCreator(classroomId) {
      let data = get(/databases/(default)/documents/classrooms/$(classroomId)).data;
      return data.createdBy == request.auth.uid
        || data.teacherId == request.auth.uid
        || data.teacherUid == request.auth.uid
        || data.ownerId == request.auth.uid;
    }
    function isClassroomMember(classroomId) {
      return exists(/databases/(default)/documents/classrooms/$(classroomId)/members/$(request.auth.uid));
    }

    match /profile_pics/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId && isImageBelowMaxSize(5);
      allow read;
    }
    match /{userId}/{messageId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId && isImageBelowMaxSize(5);
      allow read;
    }
    match /classrooms/{classroomId}/files/{fileId}/{fileName} {
      allow read: if request.auth != null && (isClassroomCreator(classroomId) || isClassroomMember(classroomId));
      allow write, delete: if request.auth != null && isClassroomCreator(classroomId);
    }
  }
}
